# Copy to .env.local and fill in. Never commit .env.local.
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional. Desmos graphing API key. Without it the public trial key is used,
# which is fine for prototyping. Request a key at https://www.desmos.com/my-api
NEXT_PUBLIC_DESMOS_API_KEY=
